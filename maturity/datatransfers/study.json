  "sub_indicators": [
    {
      "key": "rule",
      "label": "Rule on sending data abroad",
      "subject": "gov.regional",
      "text": "Cross-border data transfers: rule on sending data abroad",
      "indicator_id": "gov.regional--cross-border-data-transfers",
      "norm_short": "The AfCFTA Digital Trade Protocol (2024) and the AU Data Policy Framework (2022) ask states to let data cross borders under stated safeguards; the Malabo Convention, Article 14, asks that data sent abroad be adequately protected.",
      "class": "rule",
      "criteria": [
        "A rule keeps personal data in general in the country, with no rule on sending it abroad; or a source from the past three years says nothing protects personal data sent abroad.",
        "Personal data sent abroad is protected but the door is mostly shut: a transfer rule is being written, or the rule in force makes every transfer wait on the authority's permission, or a rule keeping personal data at home stands beside it.",
        "A rule in force protects personal data sent abroad and lets some transfers go without permission each time, to a country judged adequate, on consent or under a contract; no rule keeps personal data in general at home.",
        "As stage 3, and the authority has published a way to send data without asking: a list of countries data may go to, model contract terms, or a general authorisation.",
        "As stage 4, and the country is open to its African partners: it has ratified the AfCFTA Digital Trade Protocol or the Malabo Convention, or treats a regional partner's protection as good enough in practice."
      ],
